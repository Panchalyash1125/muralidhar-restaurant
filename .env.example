# ============================================
# MURALIDHAR RESTAURANT SYSTEM
# Environment Configuration
# Copy this file to .env and update values
# ============================================

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
DB_PATH=./backend/database/restaurant.db

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Admin Credentials (change in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Firebase Phone Authentication
# Public project ID used by the backend to validate Firebase ID tokens.
# No Firebase service-account private key is required by this implementation.
FIREBASE_PROJECT_ID=muralidhar-restaurant

# OTP UI controls (Firebase controls the real SMS/code lifetime)
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=3

# GST Rate
GST_RATE=0.05

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:8080
